# Azure AI Foundry project endpoint
# Found in: Azure AI Foundry portal → your project → Overview → Endpoint
AZURE_FOUNDRY_ENDPOINT=https://<your-hub>.services.ai.azure.com/api/projects/<your-project>

# Name of the model deployment inside the project (e.g. gpt-4o)
AZURE_MODEL_DEPLOYMENT=gpt-4o

# No API key needed — DefaultAzureCredential handles auth via:
#   Azure CLI  →  az login
#   Managed Identity  →  automatic in ACI / Container Apps / AKS
#   Service Principal →  set AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID

RETIREMENT_DB_PATH=data/retirement.db
CHECKPOINT_DB_PATH=data/checkpoints.db
